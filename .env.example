# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Dev: the Postgres started by `pnpm db:up`. In the prod compose profile the
# containers override this with the in-network host `db`.
DATABASE_URL=postgres://foray:foray@localhost:5432/foray

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional in Phase 1 — email+password works locally without it. Google is the
# path to Gmail scopes in Phase 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LLM providers — set any subset. There is no vendor default in code.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible slot (OpenRouter, Together, a local server, ...)
LLM_COMPAT_BASE_URL=
LLM_COMPAT_API_KEY=

# ---------------------------------------------------------------------------
# Model per purpose — `provider:model`. LLM_DEFAULT is required; the rest fall
# back to it. `extract` and `merge` need a vision-capable model (PDF-image
# fallback for garbled resumes).
#
# Price sheet, USD per million tokens (in / out), checked 2026-09-17 —
# re-check with `pnpm tsx scripts/model-bakeoff.ts` before committing to one.
#
#   cheap tier   deepseek:deepseek-flash    0.30 / 1.20 peak, 0.15 / 0.60 off-peak, cached input ~free
#                openai:gpt-5.6-luna        0.20 / 1.20
#                google:gemini-3.8-flash    0.75 / 3.75   (promo through 2026-12-31)
#                anthropic:claude-haiku-4-5 1.00 / 5.00
#   strong tier  openai:gpt-5.6-terra       2.00 / 12.00
#                google:gemini-3.1-pro-preview 2.00 / 12.00
#                anthropic:claude-sonnet-5  2.00 / 10.00
#                anthropic:claude-opus-5    5.00 / 25.00
#
# Rough shape: bulk work (score, extract, verify) on the cheap tier; judgment
# work (evaluate, tailor) on the strong tier; chat somewhere in between.
# ---------------------------------------------------------------------------
LLM_DEFAULT=
# LLM_CHAT=
# LLM_EXTRACT=
# LLM_SCORE=
# LLM_EVALUATE=
# LLM_TAILOR=
# LLM_VERIFY=
# LLM_MERGE=

# Reasoning effort per purpose: none | minimal | low | medium | high | xhigh.
# The single largest cost lever in the product. Measured on DeepSeek Flash,
# 92% of the output tokens a scoring call produces are reasoning tokens — about
# 2,085 of 2,255 — for a task whose answer is a number and three short phrases.
# Turning it off took scoring from roughly $1.50 per 500 postings to $0.24.
LLM_REASONING_SCORE=none
# LLM_REASONING_CHAT=
# LLM_REASONING_EXTRACT=
# LLM_REASONING_EVALUATE=
# LLM_REASONING_TAILOR=
# LLM_REASONING_VERIFY=
# LLM_REASONING_MERGE=

# Requests per minute per provider (token bucket in lib/llm/limiter.ts).
# Defaults to 300, which is well under a paid account's real limit. Lower it if
# you are on a new account with low limits; raising it past what the provider
# allows just converts waiting into 429s.
LLM_RPM_OPENAI=500
# LLM_RPM_GOOGLE=
# LLM_RPM_DEEPSEEK=
# LLM_RPM_ANTHROPIC=
# LLM_RPM_COMPAT=

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# RapidAPI key for JSearch (aggregates LinkedIn/Indeed/Glassdoor/ZipRecruiter).
# Free tier is 200 requests/month; each result page bills one request.
RAPIDAPI_KEY=
JSEARCH_ENABLED=false

# Optional: Brave Search API (free tier) so company discovery can resolve a
# plain company name to a domain. Discovery still works without it, from URLs
# and ATS slug guesses.
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Uploads and rendered PDFs (gitignored). Containers mount a volume here.
STORAGE_DIR=./data
WORKER_CONCURRENCY=4
