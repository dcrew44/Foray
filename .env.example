# Foray's configuration, shared by Next (web) and Django (api, worker, manage.py).
# backend/foray/env.py validates every value at boot and names the variable to fix.
# An empty value means unset. Real environment variables win over this file.

# ---------------------------------------------------------------------------
# Database and files
# ---------------------------------------------------------------------------
# The app database, created by `pnpm db:create` and migrated by `pnpm db:migrate`.
# In the prod compose profile the containers override this with the host `db`.
# The backend refuses a database named `foray`: that is the legacy app's.
DATABASE_URL=postgres://foray:foray@localhost:5432/foray_app

# Read only by the one-off legacy import (pnpm db:import-legacy); never written.
# LEGACY_DATABASE_URL=postgres://foray:foray@localhost:5432/foray
# LEGACY_STORAGE_DIR=/absolute/path/to/the/old/data

# Uploads and rendered PDFs (gitignored), shared by the api and the worker.
# Relative paths resolve against the repo root.
STORAGE_DIR=./storage
# Database dumps and file manifests made by `pnpm db:backup-legacy`.
# BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# At least 50 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Development switches: dev sessions, test users, /api/docs, /api/health/stream, LLM_FAKE.
DEBUG=true
# The URL the browser opens. Used for the Origin check, Secure cookies and links.
PUBLIC_ORIGIN=http://localhost:3000
# Where Next sends /api/* (the rewrite) and where server components fetch from.
DJANGO_ORIGIN=http://127.0.0.1:8000
# false answers sign-ups with 403. Any public deployment sets it to false.
# SIGNUP_OPEN=true
# How many X-Forwarded-For hops a trusted front proxy appends (0 when there is none).
# TRUSTED_PROXY_HOPS=0
# Initial time zone for new users; chat replaces it with the browser's.
# APP_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# LLM providers — set any subset. There is no vendor default in code.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible slot (OpenRouter, Together, a local server, ...)
LLM_COMPAT_BASE_URL=
LLM_COMPAT_API_KEY=

# ---------------------------------------------------------------------------
# Model per purpose — `provider:model`. LLM_DEFAULT is required; the rest fall
# back to it, never to another vendor, and each purpose's provider needs its
# key. `extract` and `merge` need a vision-capable model (PDF-image fallback
# for garbled resumes).
#
# Price sheet, USD per million tokens (in / out), checked 2026-09-17 —
# re-check with `pnpm llm:bakeoff` before committing to one.
#
#   cheap tier   deepseek:deepseek-flash    0.30 / 1.20 peak, 0.15 / 0.60 off-peak, cached input ~free
#                openai:gpt-5.6-luna        0.20 / 1.20
#                google:gemini-3.8-flash    0.75 / 3.75   (promo through 2026-12-31)
#                anthropic:claude-haiku-4-5 1.00 / 5.00
#   strong tier  openai:gpt-5.6-terra       2.00 / 12.00
#                google:gemini-3.1-pro-preview 2.00 / 12.00
#                anthropic:claude-sonnet-5  2.00 / 10.00
#                anthropic:claude-opus-5    5.00 / 25.00
#
# Rough shape: bulk work (score, extract, verify) on the cheap tier; judgment
# work (evaluate, tailor) on the strong tier; chat somewhere in between.
# ---------------------------------------------------------------------------
LLM_DEFAULT=
# LLM_CHAT=
# LLM_EXTRACT=
# LLM_SCORE=
# LLM_EVALUATE=
# LLM_TAILOR=
# LLM_VERIFY=
# LLM_MERGE=

# Reasoning effort per purpose: none | minimal | low | medium | high | xhigh.
# An invalid value stops the app at boot. The single largest cost lever in the
# product. Measured on DeepSeek Flash, 92% of the output tokens a scoring call
# produces are reasoning tokens — about 2,085 of 2,255 — for a task whose answer
# is a number and three short phrases. Turning it off took scoring from roughly
# $1.50 per 500 postings to $0.24.
LLM_REASONING_SCORE=none
# LLM_REASONING_CHAT=
# LLM_REASONING_EXTRACT=
# LLM_REASONING_EVALUATE=
# LLM_REASONING_TAILOR=
# LLM_REASONING_VERIFY=
# LLM_REASONING_MERGE=

# Requests per minute per provider, per process (the api and the worker each
# get this many). Defaults to 300, which is well under a paid account's real
# limit. Raising it past what the provider allows just converts waiting into 429s.
LLM_RPM_OPENAI=500
# LLM_RPM_GOOGLE=
# LLM_RPM_DEEPSEEK=
# LLM_RPM_ANTHROPIC=
# LLM_RPM_COMPAT=

# Model calls stop for the month once the ledger reaches this many dollars.
# LLM_MONTHLY_BUDGET_USD=90

# Deterministic fake models, for rehearsals at $0 (DEBUG only). LLM_FAKE_FAIL
# makes the listed purposes fail; LLM_FAKE_DELAY_MS slows replies enough to
# press Stop. Both need LLM_FAKE.
# LLM_FAKE=1
# LLM_FAKE_FAIL=tailor
# LLM_FAKE_DELAY_MS=8000

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# RapidAPI key for JSearch (aggregates LinkedIn/Indeed/Glassdoor/ZipRecruiter).
# Free tier is 200 requests/month; each result page bills one request.
RAPIDAPI_KEY=
JSEARCH_ENABLED=false
# The app stops using JSearch for the month at this many requests.
# JSEARCH_MONTHLY_BUDGET=180

# Optional: Brave Search API (free tier) so company discovery can resolve a
# plain company name to a domain. Discovery still works without it, from URLs
# and ATS slug guesses.
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Jobs the worker's background lane runs at once (searches, refreshes): 1 to 8.
WORKER_CONCURRENCY=3
# Pooled database connections per process (and db() threads): 4 to 50.
# DB_POOL_MAX=10
# Resume PDFs render in headless Chromium. Unset uses the bundled browser
# (present in the worker image) and falls back to an installed Google Chrome.
# PDF_BROWSER_CHANNEL=chrome
