# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
next-env.d.ts

# production build
dist/
build/
*.tsbuildinfo

# environment: every .env variant holds secrets (step 13 keeps the old one as .env.legacy);
# only the template is tracked
.env
.env.*
!.env.example

# runtime data (uploads, rendered PDFs) — see STORAGE_DIR
data/
# the Django store and the migration backups (STORAGE_DIR, BACKUP_DIR), and the store the
# cutover moves aside (storage.pre-cutover-<stamp>)
/storage/
/storage.*/
/backups/

# test output
coverage/
test-results/
playwright-report/
blob-report/

# editors / OS
.DS_Store
*.log
npm-debug.log*
yarn-error.log*
.idea/

# python prototype leftovers (see git tag python-prototype)
__pycache__/
*.pyc
.venv/

# scratch scripts used while verifying a step
/.*.ts
