{
  "name": "foray",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "docker:prod": "docker compose --profile prod up --build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config src/lib/auth/index.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:all": "concurrently -n next,worker -c cyan,magenta \"pnpm dev\" \"pnpm dev:worker\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "llm:smoke": "tsx scripts/llm-smoke.ts",
    "llm:bakeoff": "tsx scripts/model-bakeoff.ts",
    "fetch:board": "tsx scripts/fetch-board.ts",
    "verify:boards": "tsx scripts/verify-boards.ts",
    "seed:companies": "tsx scripts/seed-companies.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/deepseek": "^3.0.48",
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/openai": "^4.0.70",
    "@ai-sdk/openai-compatible": "^3.0.52",
    "@ai-sdk/react": "^4.0.109",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@napi-rs/canvas": "^1.0.9",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^7.0.106",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "motion": "^13.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
